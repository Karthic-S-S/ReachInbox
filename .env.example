MYSQL_DATABASE=reachinbox
MYSQL_SHADOW_DATABASE=reachinbox_shadow
MYSQL_USER=reachinbox
MYSQL_PASSWORD=replace_with_a_local_development_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password
MYSQL_PORT=3307
REDIS_PORT=6380
ELASTICSEARCH_PORT=9200
# Backend application auth configuration (copy these into backend/.env as well).
FRONTEND_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
