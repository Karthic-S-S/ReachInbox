PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
AUTH_ENABLED=true
AUTH_COOKIE_NAME=reachinbox_session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=replace_with_a_random_32_character_or_longer_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
DATABASE_URL="mysql://reachinbox:replace_with_a_local_development_password@localhost:3307/reachinbox"
SHADOW_DATABASE_URL="mysql://reachinbox:replace_with_a_local_development_password@localhost:3307/reachinbox_shadow"
REDIS_HOST=localhost
REDIS_PORT=6380
WORKER_CONCURRENCY=5
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000
PROCESSING_TIMEOUT_MS=300000
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
BULL_BOARD_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=replace_with_ethereal_smtp_username
SMTP_PASSWORD=replace_with_ethereal_smtp_password
SMTP_FROM="ReachInbox Scheduler <replace_with_ethereal_smtp_username>"
